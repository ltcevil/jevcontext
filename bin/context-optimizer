#!/usr/bin/env bash
# context-optimizer CLI executable wrapper
set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$( cd -P "$( dirname "$SOURCE" )" >/dev/null 2>&1 && pwd )"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$( cd -P "$( dirname "$SOURCE" )" >/dev/null 2>&1 && pwd )"
TOOL_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"

if [[ -f "${TOOL_DIR}/.venv/bin/python" ]]; then
    PYTHON_EXEC="${TOOL_DIR}/.venv/bin/python"
elif [[ -f "/Volumes/ExternalUsers/evil/tools/context-optimizer/.venv/bin/python" ]]; then
    PYTHON_EXEC="/Volumes/ExternalUsers/evil/tools/context-optimizer/.venv/bin/python"
elif command -v python3 >/dev/null 2>&1; then
    PYTHON_EXEC="$(command -v python3)"
else
    echo "Error: Python 3 not found." >&2
    exit 1
fi

export PYTHONPATH="${TOOL_DIR}:${PYTHONPATH:-}"
exec "${PYTHON_EXEC}" -m context_optimizer.cli "$@"
